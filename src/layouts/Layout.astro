---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	keywords?: string;
}

const { title, description, image, keywords } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={title} description={description} image={image} keywords={keywords} />
	</head>
	<body class="bg-zinc-50 text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-50 selection:bg-green-200 selection:text-green-900 dark:selection:bg-green-900 dark:selection:text-green-100">
		<!-- Skip to main content for accessibility & SEO -->
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-[100] rounded-md bg-lime-600 px-4 py-2 text-white font-semibold focus:outline-none">Skip to main content</a>
		<Header />
		<main id="main-content">
			<slot />
		</main>
		<Footer />
	</body>
</html>
