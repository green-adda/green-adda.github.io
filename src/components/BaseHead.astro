---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: string;
	keywords?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = '/green-adda-logo.png',
	keywords = 'sustainable engineering, green technology, eco-friendly software, low-carbon web, architecture consulting, ethical AI, sustainable system design, Greenadda',
} = Astro.props;

const ogImage = new URL(image, Astro.site ?? Astro.url);

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'Greenadda',
	url: 'https://greenadda.com',
	logo: 'https://greenadda.com/green-adda-logo.png',
	description:
		'A collective of engineers, designers, and strategists dedicated to sustainable engineering and decoupling technological progress from environmental impact.',
	sameAs: [],
	contactPoint: {
		'@type': 'ContactPoint',
		email: 'contact@greenadda.com',
		contactType: 'customer support',
	},
};

// Allow Astro's HMR WebSocket in dev; lock down in production
const connectSrc = import.meta.env.DEV
	? "connect-src 'self' ws://localhost:* http://localhost:*"
	: "connect-src 'none'";

const csp = [
	"default-src 'self'",
	"script-src 'self' 'unsafe-inline'",
	"style-src 'self' 'unsafe-inline'",
	"img-src 'self' data: https:",
	"font-src 'self'",
	connectSrc,
	"base-uri 'self'",
	"form-action 'self'",
	// NOTE: frame-ancestors is intentionally omitted — browsers ignore it in <meta> tags.
	// To block framing, set the X-Frame-Options HTTP header server-side.
].join('; ');
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- Suppress framework fingerprinting -->
<meta name="generator" content="" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#4d7c0f" />

<!-- Security Headers (via meta for static hosting) -->
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
<meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" />
<meta http-equiv="Content-Security-Policy" content={csp} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content="Greenadda" />
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${title} - Greenadda`} />
<meta property="og:site_name" content="Greenadda" />
<meta property="og:locale" content="en_IN" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={`${title} - Greenadda`} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
